# Пример .env для 13 STYLES — копируется в .env автоматически скриптом orchestrate
# (npm run dev), но можно задать вручную.

# База данных SQLite. orchestrate (npm run dev) подставляет абсолютный путь
# автоматически. ВАЖНО: в file:-URL только прямые слэши — обратные слэши Windows
# Prisma не понимает («Unable to open the database file»).
#   Windows:  DATABASE_URL=file:C:/projects/13-styles/db/custom.db
#   Linux:    DATABASE_URL=file:/home/user/13-styles/db/custom.db
DATABASE_URL=file:./db/custom.db

# Публичный URL сайта (для SEO: canonical, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Админ-панель /admin (создаётся автоматически, если .env не существовал)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=13styles2024

# Секрет подписи пользовательских токенов
USER_AUTH_SECRET=change-me-to-random-hex
