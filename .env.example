# Пример .env для 13 STYLES — копируется в .env автоматически скриптом orchestrate
# (npm run dev), но можно задать вручную.

# База данных SQLite. orchestrate (npm run dev) подставляет абсолютный путь
# автоматически. ВАЖНО: в file:-URL только прямые слэши — обратные слэши Windows
# Prisma не понимает («Unable to open the database file»).
#   Windows:  DATABASE_URL=file:C:/projects/13-styles/db/custom.db
#   Linux:    DATABASE_URL=file:/home/user/13-styles/db/custom.db
DATABASE_URL=file:./db/custom.db

# Публичный URL сайта (для SEO: canonical, sitemap, OpenGraph)
# В продакшене — https://13-style.com (HTTPS протокол обязателен):
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ПОРТЫ ЗАПУСКА (меняйте, если стандартные заняты):
# PORT      — витрина Next.js (npm run dev и npm start)
# CHAT_PORT — socket.io чат-сервиса поддержки; клиент узнаёт его в рантайме
#             через /api/config/chat-port — пересборка после смены не нужна
PORT=3000
CHAT_PORT=3003

# Админ-панель /admin (создаётся автоматически, если .env не существовал)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=13styles2024

# Секрет подписи пользовательских токенов
USER_AUTH_SECRET=change-me-to-random-hex

# ---------------------------------------------------------------------------
# DOKU — платёжная система (Non-SNAP Checkout API, api.doku.com)
# ---------------------------------------------------------------------------
# Режим окружения при первом старте: production | sandbox
DOKU_ENV=production

# Для ЛОКАЛЬНОГО тестирования: принимать уведомления без валидной подписи.
# В бою ОБЯЗАТЕЛЬНО false!
DOKU_NOTIFY_ALLOW_UNVERIFIED=true

# Резервный курс EUR->IDR, используется только если живой курс недоступен
DOKU_EUR_IDR_RATE=17500

# Мерчанты: ключи берутся при старте в БД (админка → Платежи DOKU).
# CODE: funstay (по умолчанию), skyview, mpm, tsa, arbivura
DOKU_FUNSTAY_CLIENT_ID=
DOKU_FUNSTAY_SECRET_KEY=
DOKU_FUNSTAY_API_KEY=
DOKU_SKYVIEW_CLIENT_ID=
DOKU_SKYVIEW_SECRET_KEY=
DOKU_SKYVIEW_API_KEY=
DOKU_MPM_CLIENT_ID=
DOKU_MPM_SECRET_KEY=
DOKU_MPM_API_KEY=
DOKU_TSA_CLIENT_ID=
DOKU_TSA_SECRET_KEY=
DOKU_TSA_API_KEY=
DOKU_ARBIVURA_CLIENT_ID=
DOKU_ARBIVURA_SECRET_KEY=
DOKU_ARBIVURA_API_KEY=

# Тип off-session списания по сохранённой карте: MOTO (разовый) или RECURRING
# (нужен биллинг-график и активация в DOKU Console — рекуррент пока не проводится)
DOKU_CARD_OFF_SESSION_TYPE=MOTO

# SNAP / Bank Transfer (Virtual Account) — требует RSA-ключей:
# 1) сгенерировать пару ключей, публичный зарегистрировать в DOKU Console (SNAP)
# 2) приватный ключ сюда (PKCS#8 PEM, одной строкой с \n)
# DOKU_SNAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# DOKU_SNAP_PARTNER_SERVICE_ID="   19008"
