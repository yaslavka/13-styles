// PIXART MARKET — Prisma schema для MySQL
// Инструкция перехода с SQLite:
//   1. cp prisma/schema.mysql.prisma prisma/schema.prisma
//   2. В .env задать: DATABASE_URL="mysql://user:password@host:3306/pixart"
//   3. bun run db:push
// Логика кода не меняется: DTO-слой работает с JSON-строками одинаково на обеих СУБД.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id            Int           @id @default(autoincrement())
  slug          String        @unique @db.VarChar(64)
  name          String        @db.VarChar(120)
  subtitle      String        @db.VarChar(200)
  icon          String        @default("Shirt") @db.VarChar(40)
  style         Int           @default(0)
  sort          Int           @default(0)
  products      Product[]
  subcategories Subcategory[]
}

model Subcategory {
  id         Int       @id @default(autoincrement())
  slug       String    @unique @db.VarChar(64)
  name       String    @db.VarChar(120)
  sort       Int       @default(0)
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([categoryId])
}

model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(120)
  name        String   @db.VarChar(160)
  shortDesc   String   @db.VarChar(300)
  description String   @db.Text
  price       Float
  oldPrice    Float?
  gender      String   @default("unisex") @db.VarChar(16)
  sizes       String   @default("[]") @db.Text
  colors      String   @default("[]") @db.Text
  images      String   @default("[]") @db.Text
  label       String   @default("none") @db.VarChar(16)
  stock       Int      @default(10)
  rating      Float    @default(4.8)
  reviews     Int      @default(0)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  // Товар-декор: участвует в анимации главной, но скрывается из списков каталога
  decor       Boolean  @default(false)
  // Собственная ссылка на оплату товара
  paymentUrl    String   @default("") @db.VarChar(500)
  customPayment Boolean  @default(false)
  categoryId  Int
  category      Category      @relation(fields: [categoryId], references: [id])
  subcategoryId Int?
  subcategory   Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([published, featured])
}

model User {
  id           Int      @id @default(autoincrement())
  login        String   @unique @db.VarChar(40)
  name         String   @default("") @db.VarChar(80)
  // scrypt: хранится как "salt:hash"
  passwordHash String   @db.VarChar(200)
  // blocked — блокировка входа (можно снять), banned — бан аккаунта навсегда
  blocked      Boolean  @default(false)
  banned       Boolean  @default(false)
  orders         Order[]
  paymentMethods PaymentMethod[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Способ оплаты покупателя (маскированные данные карты, без полного номера)
model PaymentMethod {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @db.VarChar(120)
  brand     String   @default("card") @db.VarChar(32)
  last4     String   @default("") @db.VarChar(4)
  expiry    String   @default("") @db.VarChar(8)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Order {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(40)
  // null для гостевых заказов без авторизации
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // system — общая платёжная система, link — оплата по собственной ссылке товара
  paymentMode String @default("system") @db.VarChar(16)
  customer  String   @db.VarChar(120)
  phone     String   @db.VarChar(32)
  address   String   @db.VarChar(255)
  comment   String   @default("") @db.VarChar(600)
  total     Float
  status    String   @default("new") @db.VarChar(16)
  items     String   @default("[]") @db.Text
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}
