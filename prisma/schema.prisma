// PIXART MARKET — Prisma schema
// По умолчанию используется SQLite (файл db/custom.db).
// Для перехода на MySQL используйте prisma/schema.mysql.prisma:
//   cp prisma/schema.mysql.prisma prisma/schema.prisma && bun run db:push
// и задайте DATABASE_URL вида mysql://user:pass@host:3306/pixart

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Категория каталога (мужская одежда, женская, обувь, аксессуары)
model Category {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  name          String
  subtitle      String
  icon          String        @default("Shirt")
  // Индекс одного из 13 градиентных стилей бренда PIXART (0..12)
  style         Int           @default(0)
  sort          Int           @default(0)
  products      Product[]
  subcategories Subcategory[]
}

// Подкатегория товаров внутри категории
model Subcategory {
  id         Int       @id @default(autoincrement())
  slug       String    @unique
  name       String
  sort       Int       @default(0)
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
}

// Товар маркетплейса
model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  shortDesc   String   @default("")
  description String   @default("")
  price       Float
  oldPrice    Float?
  // men | women | unisex
  gender      String   @default("unisex")
  // JSON-строки (Prisma primitive list недоступен) — парсится в DTO слое
  sizes       String   @default("[]")
  colors      String   @default("[]")
  images      String   @default("[]")
  // none | new | hit | sale
  label       String   @default("none")
  stock       Int      @default(10)
  rating      Float    @default(4.8)
  reviews     Int      @default(0)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  // Товар-декор: участвует в анимации главной, но скрывается из списков каталога
  decor       Boolean  @default(false)
  // Собственная ссылка на оплату: если customPayment = true, кнопка «Оплатить»
  // у товара ведёт на paymentUrl, а не на общую платёжную систему
  paymentUrl    String  @default("")
  customPayment Boolean @default(false)
  categoryId  Int
  category    Category      @relation(fields: [categoryId], references: [id])
  subcategoryId Int?
  subcategory   Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Покупатель маркетплейса (авторизация по логину и паролю)
model User {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  name         String   @default("")
  // scrypt: хранится как "salt:hash"
  passwordHash String
  // blocked — блокировка входа (можно снять), banned — бан аккаунта навсегда
  blocked      Boolean  @default(false)
  banned       Boolean  @default(false)
  orders         Order[]
  paymentMethods PaymentMethod[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Способ оплаты покупателя (маскированные данные карты, без полного номера)
model PaymentMethod {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  brand     String   @default("card")
  last4     String   @default("")
  expiry    String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Заказ покупателя
model Order {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  // null для гостевых заказов без авторизации
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // system — общая платёжная система, link — оплата по собственной ссылке товара
  paymentMode String @default("system")
  customer  String
  phone     String
  address   String
  comment   String   @default("")
  total     Float
  // new | confirmed | shipped | done | canceled
  status    String   @default("new")
  // JSON [{productId, slug, name, price, qty, size, image}]
  items     String   @default("[]")
  createdAt DateTime @default(now())
}
