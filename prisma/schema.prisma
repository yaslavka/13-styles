// 13 STYLES — Prisma schema
// По умолчанию используется SQLite (файл db/custom.db).
// Для перехода на MySQL используйте prisma/schema.mysql.prisma:
//   cp prisma/schema.mysql.prisma prisma/schema.prisma && bun run db:push
// и задайте DATABASE_URL вида mysql://user:pass@host:3306/13styles

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Категория каталога (мужская одежда, женская, обувь, аксессуары)
model Category {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  name          String
  subtitle      String
  icon          String        @default("Shirt")
  // Индекс одного из 13 градиентных стилей бренда 13 STYLES (0..12)
  style         Int           @default(0)
  sort          Int           @default(0)
  products      Product[]
  subcategories Subcategory[]
}

// Подкатегория товаров внутри категории
model Subcategory {
  id         Int       @id @default(autoincrement())
  slug       String    @unique
  name       String
  sort       Int       @default(0)
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
}

// Товар маркетплейса
model Product {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  // Реальный бренд товара (извлекается из названия, например Burberry, Givenchy)
  brand       String   @default("")
  shortDesc   String   @default("")
  description String   @default("")
  price       Float
  oldPrice    Float?
  // men | women | unisex
  gender      String   @default("unisex")
  // JSON-строки (Prisma primitive list недоступен) — парсится в DTO слое
  sizes       String   @default("[]")
  colors      String   @default("[]")
  images      String   @default("[]")
  // none | new | hit | sale
  label       String   @default("none")
  stock       Int      @default(10)
  rating      Float    @default(4.8)
  reviews     Int      @default(0)
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  // Товар-декор: участвует в анимации главной, но скрывается из списков каталога
  decor       Boolean  @default(false)
  // Собственная ссылка на оплату: если customPayment = true, кнопка «Оплатить»
  // у товара ведёт на paymentUrl, а не на общую платёжную систему
  paymentUrl    String  @default("")
  customPayment Boolean @default(false)
  categoryId  Int
  category    Category      @relation(fields: [categoryId], references: [id])
  subcategoryId Int?
  subcategory   Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Покупатель маркетплейса (авторизация по логину и паролю)
model User {
  id           Int      @id @default(autoincrement())
  login        String   @unique
  name         String   @default("")
  // scrypt: хранится как "salt:hash"
  passwordHash String
  // blocked — блокировка входа (можно снять), banned — бан аккаунта навсегда
  blocked      Boolean  @default(false)
  banned       Boolean  @default(false)
  orders         Order[]
  paymentMethods PaymentMethod[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Способ оплаты покупателя (маскированные данные карты, без полного номера)
model PaymentMethod {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  brand     String   @default("card")
  last4     String   @default("")
  expiry    String   @default("")
  // Токен сохранённой карты от DOKU (для возможных off-session платежей)
  token     String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Заказ покупателя
model Order {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  // null для гостевых заказов без авторизации
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // system — общая платёжная система, link — оплата по собственной ссылке товара
  paymentMode String @default("system")
  customer  String
  phone     String
  address   String
  comment   String   @default("")
  total     Float
  // new | confirmed | shipped | done | canceled
  status    String   @default("new")
  // JSON [{productId, slug, name, price, qty, size, image}]
  items     String   @default("[]")
  createdAt DateTime @default(now())
}

// Мерчант DOKU (подключённая платёжная система). Настройки редактируются в админке.
model PaymentMerchant {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  clientId  String   @default("")
  secretKey String   @default("")
  apiKey    String   @default("")
  // Боевой или тестовый режим: production | sandbox
  mode      String   @default("production")
  // Ключи песочницы DOKU (если отличаются от боевых)
  sandboxClientId  String @default("")
  sandboxSecretKey String @default("")
  // Мерчант по умолчанию для новых платежей
  isDefault Boolean  @default(false)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Платёж DOKU по заказу
model Payment {
  id            Int      @id @default(autoincrement())
  orderCode     String
  merchantCode  String   @default("")
  // Суммы: в евро по каталогу и в IDR (то, что реально уходит в DOKU)
  amountEur     Float
  amountIdr     Int
  rate          Float
  currency      String   @default("IDR")
  // pending | success | failed | expired | canceled
  status        String   @default("pending")
  channel       String   @default("")
  // Наш Request-Id при создании и original_request_id из уведомления
  requestId     String   @default("")
  dokuRequestId String   @default("")
  invoiceNumber String   @default("")
  payUrl        String   @default("")
  sessionId     String   @default("")
  // Токенизация карты: DOKU сохраняет карту по customer.id, токен приходит в уведомлении
  cardToken     String   @default("")
  cardBrand     String   @default("")
  cardLast4     String   @default("")
  customerRef   String   @default("")
  userId        Int?
  mode          String   @default("production")
  rawRequest    String   @default("")
  rawNotify     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([orderCode])
  @@index([status])
}

// Глобальные настройки витрины (в т.ч. платёжной системы)
model Setting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}
